{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} gift card</title>
  <style>
    @font-face{font-family:Anton;font-weight:400;font-display:swap;src:url({{ 'anton-latin-400-normal.woff2' | asset_url }}) format('woff2')}
    @font-face{font-family:'Work Sans';font-weight:400;font-display:swap;src:url({{ 'work-sans-latin-400-normal.woff2' | asset_url }}) format('woff2')}
    @font-face{font-family:'Work Sans';font-weight:500;font-display:swap;src:url({{ 'work-sans-latin-500-normal.woff2' | asset_url }}) format('woff2')}
    @font-face{font-family:'Work Sans';font-weight:600;font-display:swap;src:url({{ 'work-sans-latin-600-normal.woff2' | asset_url }}) format('woff2')}
    @font-face{font-family:'Work Sans';font-weight:700;font-display:swap;src:url({{ 'work-sans-latin-700-normal.woff2' | asset_url }}) format('woff2')}
  </style>
  {{ 'anton-latin-400-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
  <style>:root{--ink:#141414;--paper:#fff;--coral:#f87f84;--yellow:#ffb844;--green:#6dc55e;--coral-text:#c2373f;--muted:#3f3f3f;--rule:#cfcfcf}</style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <section class="hero center">
    <div class="wrap">
      <img src="{{ 'taco-labs-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="110" height="110" style="margin:0 auto 12px">
      <h1 class="hero__title">{{ gift_card.initial_value | money }}</h1>
      <p class="hero__tagline mt">Gift card balance: {{ gift_card.balance | money }}</p>
      <p style="font-size:24px;font-weight:700;letter-spacing:2px">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.expired -%}<p>This gift card expired on {{ gift_card.expires_on | date: '%B %-d, %Y' }}.</p>{%- endif -%}
    </div>
  </section>
</body>
</html>
