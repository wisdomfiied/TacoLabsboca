<section class="section">
  <div class="wrap">
    <div class="section-head"><h2>{{ section.settings.heading }}</h2><a class="kicker ig-handle" href="{{ settings.instagram_url | default: section.settings.profile_url }}" target="_blank" rel="noopener">{{ section.settings.handle }}</a></div>
    <div class="ig-grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          <a class="ig-tile" href="{{ block.settings.link | default: settings.instagram_url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 33vw, 50vw', widths: '350, 700', alt: block.settings.image.alt }}
          </a>
        {%- elsif block.settings.image_asset != blank -%}
          <a class="ig-tile" href="{{ block.settings.link | default: settings.instagram_url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
            {%- render 'asset-photo', file: block.settings.image_asset, alt: 'Taco Labs on Instagram' -%}
          </a>
        {%- elsif request.design_mode -%}
          <div class="ig-tile" {{ block.shopify_attributes }}>{%- render 'photo-placeholder', label: 'Instagram post' -%}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="btn-row mt"><a class="btn btn--ink" href="{{ settings.instagram_url | default: section.settings.profile_url }}" target="_blank" rel="noopener">Follow {{ section.settings.handle }}</a></div>
  </div>
</section>
{% schema %}
{
  "name": "Instagram",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "FROM THE LAB"},
    {"type": "text", "id": "handle", "label": "Instagram handle", "default": "@tacolabs_fl"},
    {"type": "url", "id": "profile_url", "label": "Profile link (used if Theme settings › Social is empty)"}
  ],
  "blocks": [
    {"type": "post", "name": "Post", "settings": [
      {"type": "image_picker", "id": "image", "label": "Photo (square works best)"},
      {"type": "text", "id": "image_asset", "label": "Built-in photo file (used when no photo is picked)"},
      {"type": "url", "id": "link", "label": "Link to the post (optional)"}
    ]}
  ],
  "presets": [{"name": "Instagram", "blocks": [{"type": "post"}, {"type": "post"}, {"type": "post"}, {"type": "post"}, {"type": "post"}, {"type": "post"}]}]
}
{% endschema %}
