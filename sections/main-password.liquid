<section class="hero">
  <div class="wrap center">
    <img src="{{ 'taco-labs-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="120" height="120" style="margin:0 auto 16px">
    <h1 class="hero__title">EXPRESS</h1>
    {%- render 'stripe' -%}
    <p class="hero__tagline mt">{{ section.settings.message }}</p>
    <div style="max-width:420px;margin:24px auto 0">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-msg form-msg--err">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="field"><label for="pw">Store password</label><input id="pw" type="password" name="password" autocomplete="current-password"></div>
        <button class="btn btn--coral" type="submit">Enter</button>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{"name": "Password page", "settings": [{"type": "text", "id": "message", "label": "Message", "default": "Opening soon in downtown Boca Raton."}], "enabled_on": {"templates": ["password"]}}
{% endschema %}
