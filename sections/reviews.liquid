<section class="section section--ink">
  <div class="wrap">
    <div class="section-head"><h2>{{ section.settings.heading }}</h2><span class="kicker">{{ section.settings.kicker }}</span></div>
    <div class="rating-row">
      {%- for block in section.blocks -%}
        {%- assign show_rating = false -%}
        {%- if block.settings.rating != blank or request.design_mode -%}{%- assign show_rating = true -%}{%- endif -%}
        {%- if block.type == 'rating' and show_rating -%}
        <div class="rating" {{ block.shopify_attributes }}>
          <span class="rating__num">{{ block.settings.rating | default: '4.?' }}</span>
          <span class="rating__stars" aria-hidden="true">★★★★★</span>
          <span class="rating__src">{{ block.settings.source }}{% if block.settings.count != blank %} · {{ block.settings.count }}{% endif %}</span>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="reviews">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          {%- if block.settings.quote != blank -%}
          <figure class="review" {{ block.shopify_attributes }}>
            <span class="review__stars" aria-label="{{ block.settings.stars }} out of 5 stars">{% for i in (1..block.settings.stars) %}★{% endfor %}</span>
            <blockquote>{{ block.settings.quote | default: 'Paste a real Google review here.' }}</blockquote>
            <figcaption>{{ block.settings.name | default: 'Reviewer name' }}{% if block.settings.source != blank %} · {{ block.settings.source }}{% endif %}</figcaption>
          </figure>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.link != blank -%}<div class="btn-row mt"><a class="btn btn--yellow" href="{{ section.settings.link }}" target="_blank" rel="noopener">{{ section.settings.link_label }}</a></div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "WHAT BOCA SAYS"},
    {"type": "text", "id": "kicker", "label": "Small text", "default": "Real reviews from our guests"},
    {"type": "url", "id": "link", "label": "Link to all reviews (your Google Maps listing)"},
    {"type": "text", "id": "link_label", "label": "Link label", "default": "Read us on Google"}
  ],
  "blocks": [
    {"type": "rating", "name": "Rating summary", "limit": 3, "settings": [
      {"type": "text", "id": "rating", "label": "Rating", "info": "Your real rating, e.g. 4.5"},
      {"type": "text", "id": "source", "label": "Source", "default": "Google"},
      {"type": "text", "id": "count", "label": "Number of reviews", "info": "e.g. 1,500+ ratings"}
    ]},
    {"type": "review", "name": "Review", "settings": [
      {"type": "textarea", "id": "quote", "label": "Review text", "info": "Copy a real review word for word."},
      {"type": "text", "id": "name", "label": "Reviewer name (as shown on Google)"},
      {"type": "text", "id": "source", "label": "Source", "default": "Google"},
      {"type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5}
    ]}
  ],
  "presets": [{"name": "Reviews"}]
}
{% endschema %}
