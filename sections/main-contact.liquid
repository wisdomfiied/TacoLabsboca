{%- liquid
  assign tl_show = true
  if page and section.settings.only_on != blank
    assign tl_only = section.settings.only_on | remove: ' ' | split: ','
    unless tl_only contains page.handle
      assign tl_show = false
    endunless
  endif
  if page and section.settings.hide_on != blank
    assign tl_hide = section.settings.hide_on | remove: ' ' | split: ','
    if tl_hide contains page.handle
      assign tl_show = false
    endif
  endif
-%}
{%- if tl_show -%}
<section class="section">
  <div class="wrap">
    <h1 class="page-title">{{ page.title }}</h1>
    {%- render 'stripe' -%}
    {%- if page.content != blank -%}<div class="rte mt">{{ page.content }}</div>{%- endif -%}
    <div class="mt" style="max-width:640px">
      {%- form 'contact' -%}
        {%- if form.posted_successfully? -%}<p class="form-msg form-msg--ok">Thanks! We got your message and will reply soon.</p>{%- endif -%}
        {%- if form.errors -%}<p class="form-msg form-msg--err">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="field"><label for="c-name">Name</label><input id="c-name" type="text" name="contact[name]" autocomplete="name" required></div>
        <div class="field"><label for="c-email">Email</label><input id="c-email" type="email" name="contact[email]" autocomplete="email" required></div>
        <div class="field"><label for="c-phone">Phone</label><input id="c-phone" type="tel" name="contact[phone]" autocomplete="tel"></div>
        <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="contact[body]" rows="5" required></textarea></div>
        <button class="btn btn--coral" type="submit">Send</button>
      {%- endform -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "only_on",
      "label": "Only show on pages (handles, comma-separated)",
      "info": "Leave empty to show everywhere. Example: menu,deals"
    },
    {
      "type": "text",
      "id": "hide_on",
      "label": "Hide on pages (handles, comma-separated)"
    }
  ]
}
{% endschema %}
