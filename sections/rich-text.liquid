<section class="section{% if section.settings.dark %} section--ink{% endif %}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}<div class="section-head"><h2>{{ section.settings.heading }}</h2></div>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <div class="btn-row mt"><a class="btn btn--coral" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>"},
    {"type": "text", "id": "button_label", "label": "Button label"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "checkbox", "id": "dark", "label": "Dark background", "default": false}
  ],
  "presets": [{"name": "Rich text"}]
}
{% endschema %}
