<section class="section">
  <div class="wrap faq">
    <div class="section-head"><h2>{{ section.settings.heading }}</h2></div>
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div class="answer">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "QUESTIONS"}],
  "blocks": [{"type": "question", "name": "Question", "settings": [
    {"type": "text", "id": "question", "label": "Question"},
    {"type": "richtext", "id": "answer", "label": "Answer"}
  ]}],
  "presets": [{"name": "FAQ"}]
}
{% endschema %}
