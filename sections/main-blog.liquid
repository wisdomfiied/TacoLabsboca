<section class="section">
  <div class="wrap">
    <h1 class="page-title">{{ blog.title }}</h1>
    {%- render 'stripe' -%}
    {%- paginate blog.articles by 12 -%}
      {%- for article in blog.articles -%}
        <article class="item"><h2 style="font-size:30px"><a href="{{ article.url }}" style="color:var(--ink);text-decoration:none">{{ article.title }}</a></h2><p class="item__desc">{{ article.published_at | date: '%B %-d, %Y' }} · {{ article.excerpt_or_content | strip_html | truncate: 160 }}</p></article>
      {%- endfor -%}
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{"name": "Blog", "settings": [], "enabled_on": {"templates": ["blog"]}}
{% endschema %}
