<section class="section{% if section.settings.dark %} section--ink{% endif %}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
    <div class="section-head"><h2>{{ section.settings.heading }}</h2><span class="kicker">{{ section.settings.kicker }}</span></div>
    {%- endif -%}
    <div class="deals">
      {%- for block in section.blocks -%}
      <div class="deal deal--{{ block.settings.color }}" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title }}</h3>
        <span class="deal__when">{{ block.settings.when }}</span>
        {%- if block.settings.big_price != blank -%}<span class="deal__price">{{ block.settings.big_price }}</span>{%- endif -%}
        {%- assign lines = block.settings.lines | newline_to_br | split: '<br />' -%}
        {%- if block.settings.lines != blank -%}
        <ul class="deal__lines">
          {%- for l in lines -%}
            {%- assign parts = l | strip | split: '|' -%}
            {%- if parts.size > 0 -%}<li><span>{{ parts[0] | strip }}</span><b>{{ parts[1] | strip }}</b></li>{%- endif -%}
          {%- endfor -%}
        </ul>
        {%- endif -%}
        {%- if block.settings.note != blank -%}<span class="deal__note">{{ block.settings.note }}</span>{%- endif -%}
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Deals",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "DEALS AT THE LAB"},
    {"type": "text", "id": "kicker", "label": "Small text", "default": "In-store specials"},
    {"type": "checkbox", "id": "dark", "label": "Dark background", "default": false}
  ],
  "blocks": [
    {
      "type": "deal",
      "name": "Deal",
      "settings": [
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "text", "id": "when", "label": "When"},
        {"type": "text", "id": "big_price", "label": "Big price (optional)"},
        {"type": "textarea", "id": "lines", "label": "Price lines", "info": "One per line: Item | Price"},
        {"type": "text", "id": "note", "label": "Small note"},
        {"type": "select", "id": "color", "label": "Accent", "default": "yellow", "options": [{"value": "coral", "label": "Coral"}, {"value": "yellow", "label": "Yellow"}, {"value": "green", "label": "Green"}]}
      ]
    }
  ],
  "presets": [{"name": "Deals"}]
}
{% endschema %}
