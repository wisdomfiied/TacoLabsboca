{%- liquid
  assign tl_show = true
  if page and section.settings.only_on != blank
    assign tl_only = section.settings.only_on | remove: ' ' | split: ','
    unless tl_only contains page.handle
      assign tl_show = false
    endunless
  endif
  if page and section.settings.hide_on != blank
    assign tl_hide = section.settings.hide_on | remove: ' ' | split: ','
    if tl_hide contains page.handle
      assign tl_show = false
    endif
  endif
-%}
{%- if tl_show -%}
{%- assign c = section.settings.collection -%}
<section class="section">
  {%- paginate collections.all.products by 100 -%}
  <div class="wrap">
    <div class="section-head"><h2>{{ section.settings.heading }}</h2><span class="kicker">{{ section.settings.kicker }}</span></div>
    {%- if c != blank and c.products_count > 0 -%}
      <div class="items">
        {%- for product in c.products limit: section.settings.limit -%}
          {%- render 'menu-item', product: product, show_link: false -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="items">
        {%- assign shown = 0 -%}
        {%- for product in collections.all.products -%}
          {%- if shown < section.settings.limit -%}
            {%- if product.tags contains section.settings.fallback_tag or product.tags contains 'Bestseller' -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- render 'menu-item', product: product, show_link: false -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="btn-row mt"><a class="btn btn--ink" href="{{ section.settings.button_link | default: '/pages/menu' }}">{{ section.settings.button_label }}</a></div>
  </div>
  {%- endpaginate -%}
</section>
{%- endif -%}
{% schema %}
{
  "name": "Featured items",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAN FAVORITES"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Small text",
      "default": "What Boca orders most"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "fallback_tag",
      "label": "Product tag (used if no collection)",
      "default": "Fan Favorite"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Items to show",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Full Menu"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "only_on",
      "label": "Only show on pages (handles, comma-separated)",
      "info": "Leave empty to show everywhere. Example: menu,deals"
    },
    {
      "type": "text",
      "id": "hide_on",
      "label": "Hide on pages (handles, comma-separated)"
    }
  ],
  "presets": [
    {
      "name": "Featured items"
    }
  ]
}
{% endschema %}
