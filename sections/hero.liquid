{%- liquid
  assign bg = section.settings.bg_image
  assign full = false
  if section.settings.layout == 'background'
    assign full = true
  endif
  assign has_photo = false
  if bg != blank or section.settings.image_asset != blank
    assign has_photo = true
  endif
-%}
{%- if full and has_photo -%}
<section class="hero hero--photo hero--bold">
  <div class="hero__bg">
    {%- if bg != blank -%}
      {{ bg | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2400', alt: bg.alt }}
    {%- else -%}
      {%- render 'asset-photo', file: section.settings.image_asset, alt: section.settings.image_alt, width: 1192, height: 670, eager: true -%}
    {%- endif -%}
  </div>
  <div class="wrap hero__bold">
    {%- if section.settings.eyebrow != blank -%}<p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- assign lines = section.settings.headline | newline_to_br | split: '<br />' -%}
    <h1 class="hero__headline">
      {%- for line in lines -%}
        <span class="{% if forloop.last and forloop.length > 1 %}is-accent{% endif %}">{{ line | strip }}</span>
      {%- endfor -%}
    </h1>
    <p class="hero__sub">{{ section.settings.subtext }}</p>
    <div class="btn-row">
      {%- if settings.order_url != blank -%}<a class="btn btn--coral btn--lg" href="{{ settings.order_url }}" target="_blank" rel="noopener">Order Pickup</a>{%- endif -%}
      <a class="btn btn--outline btn--lg" href="{{ section.settings.menu_link | default: '/pages/menu' }}">See the Menu</a>
    </div>
    {%- if section.settings.rating_text != blank -%}<p class="hero__rating"><span aria-hidden="true">★★★★★</span> {{ section.settings.rating_text }}</p>{%- endif -%}
  </div>
  {%- if section.settings.badge_big != blank -%}
    <div class="hero__badge" aria-hidden="true"><small>{{ section.settings.badge_top }}</small><b>{{ section.settings.badge_big }}</b><small>{{ section.settings.badge_bottom }}</small></div>
  {%- endif -%}
</section>
{%- if section.settings.marquee != blank -%}
  {%- assign words = section.settings.marquee | split: ',' -%}
  <div class="marquee" aria-label="{{ section.settings.marquee | escape }}">
    <div class="marquee__track" aria-hidden="true">
      {%- for i in (1..4) -%}{%- for w in words -%}<span>{{ w | strip }}</span><i>✦</i>{%- endfor -%}{%- endfor -%}
    </div>
  </div>
{%- endif -%}
{%- else -%}
<section class="hero{% if bg != blank %} hero--photo{% endif %}">
  {%- if bg != blank -%}
    <div class="hero__bg">{{ bg | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2400', alt: bg.alt }}</div>
  {%- endif -%}
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <div class="hero__brand">
        <img src="{{ 'taco-labs-logo.png' | asset_url }}" alt="" width="110" height="110">
        <h1 class="hero__title script">{{ section.settings.title }}</h1>
      </div>
      {%- render 'stripe' -%}
      <p class="hero__tagline">{{ section.settings.tagline }}</p>
      <p class="hero__sub">{{ section.settings.subtext }}</p>
      <div class="btn-row">
        {%- if settings.order_url != blank -%}<a class="btn btn--coral btn--lg" href="{{ settings.order_url }}" target="_blank" rel="noopener">Order Pickup</a>{%- endif -%}
        <a class="btn btn--outline btn--lg" href="{{ section.settings.menu_link | default: '/pages/menu' }}">See the Menu</a>
      </div>
      {%- if section.settings.rating_text != blank -%}<p class="hero__rating"><span aria-hidden="true">★★★★★</span> {{ section.settings.rating_text }}</p>{%- endif -%}
    </div>
    <div>
      {%- if section.settings.image != blank or section.settings.image_asset != blank -%}
        <div class="hero__media">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', sizes: '(min-width: 900px) 45vw, 100vw', widths: '700, 1000, 1400', alt: section.settings.image.alt }}
          {%- else -%}
            {%- render 'asset-photo', file: section.settings.image_asset, alt: section.settings.image_alt, width: 1354, height: 1020, eager: true -%}
          {%- endif -%}
          {%- if section.settings.card_price != blank -%}<div class="hero__tag"><span>{{ section.settings.card_label }}</span><b>{{ section.settings.card_price }}</b></div>{%- endif -%}
        </div>
      {%- else -%}
        <div class="hero__price-card">
          <span class="label">{{ section.settings.card_label }}</span>
          <span class="big">{{ section.settings.card_price }}</span>
          <span style="font-weight:700;font-size:18px">{{ section.settings.card_text }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Hero",
  "settings": [
    {"type": "select", "id": "layout", "label": "Layout", "default": "background", "options": [{"value": "background", "label": "Photo behind, big headline"}, {"value": "split", "label": "Text left, photo right"}]},
    {"type": "image_picker", "id": "bg_image", "label": "Background photo (overrides the built-in photo)", "info": "Landscape, at least 2000 px wide. The photo is darkened so the text stays readable."},
    {"type": "header", "content": "Big headline layout"},
    {"type": "text", "id": "eyebrow", "label": "Small line above headline", "default": "Taco Labs Express · Boca Raton"},
    {"type": "textarea", "id": "headline", "label": "Headline", "default": "Premium tacos.\nMade fast.", "info": "One phrase per line. The last line is green."},
    {"type": "text", "id": "badge_top", "label": "Round badge: top", "default": "Made from scratch"},
    {"type": "text", "id": "badge_big", "label": "Round badge: big text", "default": "Fresh daily", "info": "Leave empty to hide the badge."},
    {"type": "text", "id": "badge_bottom", "label": "Round badge: bottom", "default": "Taco Labs"},
    {"type": "text", "id": "marquee", "label": "Scrolling strip words", "default": "Tacos, Birria, Margaritas, Premium ingredients, Made fresh daily", "info": "Comma-separated. Leave empty to hide the strip."},
    {"type": "header", "content": "Side-by-side layout"},
    {"type": "text", "id": "title", "label": "Title", "default": "Express"},
    {"type": "text", "id": "tagline", "label": "Tagline", "default": "Delicious food. Premium ingredients. Made fast."},
    {"type": "textarea", "id": "subtext", "label": "Subtext", "default": "Globally inspired tacos, birria and margaritas, made from scratch every day with high-quality meats and mostly organic ingredients. Ready in minutes in downtown Boca Raton."},
    {"type": "text", "id": "rating_text", "label": "Rating line (optional)", "info": "Use a real rating, e.g. 4.5 on Uber Eats · 1,500+ ratings"},
    {"type": "url", "id": "menu_link", "label": "Menu button link"},
    {"type": "image_picker", "id": "image", "label": "Side photo", "info": "Overrides the built-in photo below."},
    {"type": "text", "id": "image_asset", "label": "Built-in photo file", "default": "tlx-hero-spread.jpg", "info": "A photo bundled with the theme. Clear it to show the price card instead."},
    {"type": "text", "id": "image_alt", "label": "Photo description", "default": "Quesabirria, tacos, rice, beans and salad from Taco Labs"},
    {"type": "text", "id": "card_label", "label": "Price card label", "default": "ANY 3 TACOS + CHIPS & SALSA"},
    {"type": "text", "id": "card_price", "label": "Price card price", "default": "$14.99"},
    {"type": "text", "id": "card_text", "label": "Price card note", "default": "Beef & seafood tacos +50¢ each"}
  ],
  "presets": [{"name": "Hero"}]
}
{% endschema %}
